[Unit]
Description=JARVIS relay (phone <-> laptop gateway, server control)
After=network-online.target
Wants=network-online.target

[Service]
# Root on purpose: JARVIS has full control of this server.
User=root
WorkingDirectory=/opt/jarvis-relay
EnvironmentFile=/etc/jarvis-relay.env
ExecStart=/usr/bin/node /opt/jarvis-relay/relay/relay.mjs
Restart=always
RestartSec=2
# Commands JARVIS starts in the background (nohup … &) survive relay restarts.
KillMode=process

[Install]
WantedBy=multi-user.target
