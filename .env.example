EXPO_PUBLIC_OPENAI_API_KEY=
# Optional: override the chat model (default gpt-6-luna)
EXPO_PUBLIC_OPENAI_MODEL=
# Optional: override the model that analyses camera photos (default: the chat model)
EXPO_PUBLIC_OPENAI_VISION_MODEL=
# Optional: override the speech-to-text model (default gpt-transcribe)
EXPO_PUBLIC_OPENAI_TRANSCRIBE_MODEL=
# Optional: Telegram as your own account (https://my.telegram.org → API development tools)
EXPO_PUBLIC_TG_API_ID=
EXPO_PUBLIC_TG_API_HASH=
# Optional, development: 1 uses Telegram's test servers (separate session, test accounts)
EXPO_PUBLIC_TG_TEST_DC=
# Optional: how you are named in SOS alerts sent to your contacts (default Азизбек)
EXPO_PUBLIC_OWNER_NAME=
# Optional: control your laptop and server (see remote/README.md)
EXPO_PUBLIC_JARVIS_REMOTE_URL=
EXPO_PUBLIC_JARVIS_REMOTE_TOKEN=
